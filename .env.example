# Copy to .env, replace placeholders locally, and never commit .env.
POSTGRES_DB=lisa
POSTGRES_USER=lisa
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Use the same password as POSTGRES_PASSWORD. Percent-encode reserved
# characters in the password portion of this URL (for example, @ becomes %40).
LISA_DATABASE_URL=postgresql+asyncpg://lisa:replace-with-url-encoded-password@postgres:5432/lisa

OPENAI_API_KEY=replace-with-your-openai-api-key
TAVILY_API_KEY=replace-with-your-tavily-api-key

# Defaults are for the local Compose deployment.
LISA_CORS_ALLOWED_ORIGINS=http://localhost:3000
NET_TOOLS_API_URL=http://net-tools-app:8000
LISA_API_URL=http://localhost:8008
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Leave both keys blank to keep Langfuse disabled.
# Set all three only after verifying that the URL is reachable from the API container.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
